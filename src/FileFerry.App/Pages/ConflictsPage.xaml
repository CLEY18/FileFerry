<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="FileFerry.App.Pages.ConflictsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:FileFerry.App.Resources"
    xmlns:tok="clr-namespace:FileFerry.App"
    xmlns:vm="clr-namespace:FileFerry.App.ViewModels"
    x:DataType="vm:ConflictsViewModel"
    BackgroundColor="{DynamicResource Background}"
    Title="{x:Static res:AppStrings.DetailsConflictsTitle}">
    <!-- Conflicts screen: KeepBoth warning-conflict rows; reassuring empty state.-->
    <Grid Padding="{x:Static tok:DesignTokens.ScreenPadding}">
        <CollectionView
            ItemsSource="{Binding Items}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConflictRow">
                    <Border
                        BackgroundColor="{DynamicResource Surface}"
                        Padding="{x:Static tok:DesignTokens.Space16}"
                        Margin="{StaticResource CardBottomMargin}"
                        SemanticProperties.Description="{Binding SemanticDescription}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{x:Static tok:DesignTokens.RadiusControl}" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="{x:Static tok:DesignTokens.Space8}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{x:Static tok:DesignTokens.Space8}">
                                <Label
                                    Text="{x:Static tok:GlyphMapping.Merge}"
                                    Style="{StaticResource IconGlyph24}"
                                    TextColor="{DynamicResource StatusWarning}"
                                    VerticalOptions="Center"
                                    tok:A11y.IsDecorative="True" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding PathText}"
                                    Style="{StaticResource Body15Strong}"
                                    LineBreakMode="TailTruncation"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Label
                                Text="{Binding Message}"
                                Style="{StaticResource Caption13}"
                                TextColor="{DynamicResource TextSecondary}" />
                            <Label
                                Text="{Binding WhenText}"
                                Style="{StaticResource Caption13}" />
                            <!-- state line: what the run kept, or the kept side after a resolution;
                                 a folder row awaiting its action has none—the actions are the guidance-->
                            <Label
                                Text="{Binding StatusText}"
                                Style="{StaticResource Caption13}"
                                TextColor="{DynamicResource PrimaryText}"
                                IsVisible="{Binding HasStatus}" />
                            <!-- actions only while the conflict is unacknowledged-->
                            <HorizontalStackLayout
                                Spacing="{x:Static tok:DesignTokens.Space8}"
                                IsVisible="{Binding ShowActions}">
                                <Button
                                    Text="{x:Static res:AppStrings.ConflictKeepServer}"
                                    Style="{StaticResource TextButton}"
                                    Command="{Binding KeepServerCommand}"
                                    CommandParameter="{Binding .}" />
                                <Button
                                    Text="{x:Static res:AppStrings.ConflictKeepLocal}"
                                    Style="{StaticResource TextButton}"
                                    Command="{Binding KeepLocalCommand}"
                                    CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                            <!-- folder actions: rename (one MOVE) or delete (buffer first), either side-->
                            <Grid
                                ColumnDefinitions="Auto,Auto"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="{x:Static tok:DesignTokens.Space4}"
                                ColumnSpacing="{x:Static tok:DesignTokens.Space8}"
                                IsVisible="{Binding ShowFolderActions}">
                                <Button
                                    Text="{x:Static res:AppStrings.ConflictFolderRenameServer}"
                                    Style="{StaticResource TextButton}"
                                    Command="{Binding FolderRenameServerCommand}"
                                    CommandParameter="{Binding .}" />
                                <Button
                                    Grid.Column="1"
                                    Text="{x:Static res:AppStrings.ConflictFolderRenameLocal}"
                                    Style="{StaticResource TextButton}"
                                    Command="{Binding FolderRenameLocalCommand}"
                                    CommandParameter="{Binding .}" />
                                <Button
                                    Grid.Row="1"
                                    Text="{x:Static res:AppStrings.ConflictFolderDeleteServer}"
                                    Style="{StaticResource TextButton}"
                                    Command="{Binding FolderDeleteServerCommand}"
                                    CommandParameter="{Binding .}" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{x:Static res:AppStrings.ConflictFolderDeleteLocal}"
                                    Style="{StaticResource TextButton}"
                                    Command="{Binding FolderDeleteLocalCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Spacing="{x:Static tok:DesignTokens.Space12}"
                    Padding="{x:Static tok:DesignTokens.Space24}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label
                        Text="{x:Static tok:GlyphMapping.CheckCircle}"
                        Style="{StaticResource IconEmptyState}"
                        TextColor="{DynamicResource StatusSuccess}"
                        HorizontalOptions="Center"
                        tok:A11y.IsDecorative="True" />
                    <Label
                        Text="{x:Static res:AppStrings.ConflictsEmptyTitle}"
                        Style="{StaticResource Heading20}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="{x:Static res:AppStrings.ConflictsEmptyBody}"
                        Style="{StaticResource Body15}"
                        TextColor="{DynamicResource TextSecondary}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
