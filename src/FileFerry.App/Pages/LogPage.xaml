<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="FileFerry.App.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:FileFerry.App.Converters"
    xmlns:res="clr-namespace:FileFerry.App.Resources"
    xmlns:theming="clr-namespace:FileFerry.App.Theming"
    xmlns:tok="clr-namespace:FileFerry.App"
    xmlns:views="clr-namespace:FileFerry.App.Views"
    xmlns:vm="clr-namespace:FileFerry.App.ViewModels"
    x:DataType="vm:LogViewModel"
    BackgroundColor="{DynamicResource Background}"
    Title="{x:Static res:AppStrings.LogTitle}">
    <!-- Global log: filter chips on top; 13 Caption rows; no autoscroll.-->
    <Grid Padding="{x:Static tok:DesignTokens.ScreenPadding}" RowDefinitions="Auto,*" RowSpacing="{x:Static tok:DesignTokens.Space12}">

        <HorizontalStackLayout
            Grid.Row="0"
            Spacing="{x:Static tok:DesignTokens.Space8}"
            BindableLayout.ItemsSource="{Binding Filters}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:LogFilterChip">
                    <views:PressableBorder
                        Padding="{x:Static tok:DesignTokens.Space12}, {x:Static tok:DesignTokens.Space8}">
                        <!-- the token names the color, the stamp re-reads it when the palette is re-mapped -->
                        <views:PressableBorder.BackgroundColor>
                            <MultiBinding Converter="{x:Static conv:ThemeTokenConverter.Instance}">
                                <Binding Path="BackgroundToken" />
                                <Binding Path="Version" Source="{x:Static theming:ThemeState.Instance}" x:DataType="theming:ThemeState" />
                            </MultiBinding>
                        </views:PressableBorder.BackgroundColor>
                        <views:PressableBorder.StrokeShape>
                            <RoundRectangle CornerRadius="{x:Static tok:DesignTokens.RadiusChip}" />
                        </views:PressableBorder.StrokeShape>
                        <views:PressableBorder.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                        </views:PressableBorder.GestureRecognizers>
                        <HorizontalStackLayout Spacing="{x:Static tok:DesignTokens.Space4}">
                            <!-- the selected segment wears a mark, not only a color; the glyph keeps its
                                 place always (constant chip width) and is transparent until selected -->
                            <Label
                                Text="{x:Static tok:GlyphMapping.CheckCircle}"
                                Style="{StaticResource IconGlyph24}"
                                VerticalOptions="Center"
                                tok:A11y.IsDecorative="True">
                                <Label.TextColor>
                                    <MultiBinding Converter="{x:Static conv:ThemeTokenConverter.Instance}">
                                        <Binding Path="MarkToken" />
                                        <Binding Path="Version" Source="{x:Static theming:ThemeState.Instance}" x:DataType="theming:ThemeState" />
                                    </MultiBinding>
                                </Label.TextColor>
                            </Label>
                            <Label
                                Text="{Binding Label}"
                                Style="{StaticResource Body15}"
                                VerticalOptions="Center">
                                <Label.TextColor>
                                    <MultiBinding Converter="{x:Static conv:ThemeTokenConverter.Instance}">
                                        <Binding Path="TextToken" />
                                        <Binding Path="Version" Source="{x:Static theming:ThemeState.Instance}" x:DataType="theming:ThemeState" />
                                    </MultiBinding>
                                </Label.TextColor>
                            </Label>
                            <!-- the trailing spacer balances the mark slot (the row spacing sits
                                 on both sides of it): an unselected chip reads as centered -->
                            <BoxView
                                Color="Transparent"
                                WidthRequest="{x:Static tok:DesignTokens.IconMedium}"
                                tok:A11y.IsDecorative="True" />
                        </HorizontalStackLayout>
                    </views:PressableBorder>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Items}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LogRow">
                    <!-- formatting: 12:04 · Projects · message; monospace is not needed-->
                    <Grid
                        ColumnDefinitions="Auto,*,*"
                        ColumnSpacing="{x:Static tok:DesignTokens.Space8}"
                        MinimumHeightRequest="{x:Static tok:DesignTokens.Space24}"
                        SemanticProperties.Description="{Binding SemanticDescription}">
                        <Label
                            Text="{Binding Time}"
                            Style="{StaticResource Caption13}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding PairName}"
                            Style="{StaticResource Caption13}"
                            TextColor="{DynamicResource TextSecondary}"
                            LineBreakMode="TailTruncation"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="2"
                            Text="{Binding Text}"
                            Style="{StaticResource Caption13}"
                            LineBreakMode="TailTruncation"
                            VerticalOptions="Center">
                            <Label.TextColor>
                                <MultiBinding Converter="{x:Static conv:ThemeTokenConverter.Instance}">
                                    <Binding Path="ColorToken" />
                                    <Binding Path="Version" Source="{x:Static theming:ThemeState.Instance}" x:DataType="theming:ThemeState" />
                                </MultiBinding>
                            </Label.TextColor>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label
                    Text="{x:Static res:AppStrings.DetailsLogEmpty}"
                    Style="{StaticResource Body15}"
                    TextColor="{DynamicResource TextSecondary}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
