<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="FileFerry.App.Pages.PairListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:FileFerry.App.Resources"
    xmlns:theming="clr-namespace:FileFerry.App.Theming"
    xmlns:tok="clr-namespace:FileFerry.App"
    xmlns:views="clr-namespace:FileFerry.App.Views"
    xmlns:vm="clr-namespace:FileFerry.App.ViewModels"
    x:DataType="vm:PairListViewModel"
    BackgroundColor="{DynamicResource Background}"
    Title="{x:Static res:AppStrings.AppDisplayName}">
    <!-- Pair list: account dns chip → PairCard list (pull-to-refresh) → FAB; EmptyState.-->
    <Grid
        Padding="{x:Static tok:DesignTokens.ScreenPadding}"
        RowDefinitions="Auto,*"
        MaximumWidthRequest="{x:Static tok:DesignTokens.ContentMaxWidth}"
        HorizontalOptions="Center">

        <!-- account chip: tap → account screen; the outer row is the 48 dp touch box -->
        <HorizontalStackLayout
            Grid.Row="0"
            Padding="{x:Static tok:DesignTokens.Space4}"
            MinimumHeightRequest="{x:Static tok:DesignTokens.TouchTargetAndroid}"
            HorizontalOptions="Start"
            VerticalOptions="Center">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AccountCommand}" />
            </HorizontalStackLayout.GestureRecognizers>
            <HorizontalStackLayout
                Spacing="{x:Static tok:DesignTokens.Space8}"
                VerticalOptions="Start">
                <Label
                    Text="{x:Static tok:GlyphMapping.Dns}"
                    Style="{StaticResource IconGlyph24}"
                    TextColor="{DynamicResource TextSecondary}"
                    VerticalOptions="Center"
                    tok:A11y.IsDecorative="True" />
                <Label
                    Text="{Binding AccountLabel}"
                    Style="{StaticResource Caption13}"
                    VerticalOptions="Center" />
                <!-- cleartext account: the warning rides the chip itself, not a one-off dialog -->
                <HorizontalStackLayout
                    Spacing="{x:Static tok:DesignTokens.Space4}"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsInsecure}">
                    <Label
                        Text="{x:Static tok:GlyphMapping.Error}"
                        Style="{StaticResource IconGlyph24}"
                        TextColor="{DynamicResource StatusWarning}"
                        VerticalOptions="Center"
                        tok:A11y.IsDecorative="True" />
                    <Label
                        Text="{x:Static res:AppStrings.AccountInsecure}"
                        Style="{StaticResource Caption13}"
                        TextColor="{DynamicResource StatusWarning}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </HorizontalStackLayout>

        <!-- pull-to-refresh = "check and sync everything" (the actual run is queued to the engine)-->
        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsBusy}"
            Command="{Binding RefreshCommand}">
            <CollectionView
                ItemsSource="{Binding Items}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PairListItem">
                        <!-- PairCard Surface, radius 8, in three layers: the visual below, a transparent
                             Button above it for the platform press feedback (ripple and keyboard focus),
                             the menu opener topmost so its own tap stays separate from the card tap.
                             The reader hears the Button's single description; the visual subtree is decoration. -->
                        <Grid>
                            <Border
                                BackgroundColor="{DynamicResource Surface}"
                                Padding="{x:Static tok:DesignTokens.Space16}"
                                Margin="{StaticResource CardBottomMargin}"
                                tok:A11y.IsDecorative="True">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{x:Static tok:DesignTokens.RadiusControl}" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="{x:Static tok:DesignTokens.Space4}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{x:Static tok:DesignTokens.Space8}">
                                        <Label
                                            Text="{Binding RemotePath}"
                                            Style="{StaticResource Body15Strong}"
                                            LineBreakMode="TailTruncation"
                                            VerticalOptions="Center" />
                                        <!-- the opener's slot; the opener itself sits in the top layer, in this column -->
                                        <BoxView
                                            Grid.Column="1"
                                            WidthRequest="{x:Static tok:DesignTokens.TouchTargetAndroid}"
                                            HeightRequest="{x:Static tok:DesignTokens.TouchTargetAndroid}"
                                            Color="Transparent"
                                            tok:A11y.IsDecorative="True" />
                                    </Grid>
                                    <Label Text="{Binding LocalSummary}" Style="{StaticResource Caption13}" />
                                    <views:SyncStatusBadge
                                        State="{Binding Status}"
                                        Text="{Binding StatusText}"
                                        ThemeStamp="{Binding Version, Source={x:Static theming:ThemeState.Instance}, x:DataType=theming:ThemeState}"
                                        HorizontalOptions="Start" />
                                    <!-- progress bar — only during a run; fed by the live run feed-->
                                    <ProgressBar
                                        Progress="{Binding Progress}"
                                        ProgressColor="{DynamicResource Primary}"
                                        HeightRequest="{x:Static tok:DesignTokens.Space4}"
                                        IsVisible="{Binding IsSyncing}" />
                                    <Label
                                        Text="{Binding ProgressText}"
                                        Style="{StaticResource Caption13}"
                                        TextColor="{DynamicResource TextSecondary}"
                                        IsVisible="{Binding IsSyncing}" />
                                </VerticalStackLayout>
                            </Border>
                            <Button
                                BackgroundColor="Transparent"
                                Margin="{StaticResource CardBottomMargin}"
                                tok:PressRipple.Enabled="True"
                                Command="{Binding TapCommand}"
                                CommandParameter="{Binding .}"
                                SemanticProperties.Description="{Binding SemanticDescription}">
                                <!-- long-press => native context menu (FlyoutBase.ContextFlyout, Android)-->
                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Text="{Binding MenuPauseLabel}"
                                            Command="{Binding PauseCommand}"
                                            CommandParameter="{Binding .}" />
                                        <MenuFlyoutItem
                                            Text="{x:Static res:AppStrings.SyncNowAction}"
                                            Command="{Binding SyncNowCommand}"
                                            CommandParameter="{Binding .}" />
                                        <MenuFlyoutItem
                                            Text="{x:Static res:AppStrings.CardActionDelete}"
                                            Command="{Binding DeleteCommand}"
                                            CommandParameter="{Binding .}" />
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>
                            </Button>
                            <!-- the glyph sits flush with the card's 16dp inset (like the text
                                 on the left); the 48dp box around it is invisible touch margin -->
                            <Grid
                                Padding="{x:Static tok:DesignTokens.Space16}"
                                HorizontalOptions="End"
                                VerticalOptions="Start">
                                <Grid
                                    WidthRequest="{x:Static tok:DesignTokens.TouchTargetAndroid}"
                                    HeightRequest="{x:Static tok:DesignTokens.TouchTargetAndroid}"
                                    SemanticProperties.Description="{x:Static res:AppStrings.CardActionMenu}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding MenuCommand}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label
                                        Text="{x:Static tok:GlyphMapping.MoreVert}"
                                        Style="{StaticResource IconGlyph24}"
                                        TextColor="{DynamicResource TextSecondary}"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        tok:A11y.IsDecorative="True" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- EmptyState-->
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Spacing="{x:Static tok:DesignTokens.Space12}"
                        Padding="{x:Static tok:DesignTokens.Space24}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Label
                            Text="{x:Static tok:GlyphMapping.Folder}"
                            Style="{StaticResource IconEmptyState}"
                            HorizontalOptions="Center"
                            tok:A11y.IsDecorative="True" />
                        <Label
                            Text="{x:Static res:AppStrings.PairListEmptyTitle}"
                            Style="{StaticResource Heading20}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            SemanticProperties.HeadingLevel="Level1" />
                        <Label
                            Text="{x:Static res:AppStrings.PairListEmptyBody}"
                            Style="{StaticResource Body15}"
                            TextColor="{DynamicResource TextSecondary}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                        <Button
                            Text="{x:Static res:AppStrings.PairListAdd}"
                            Style="{StaticResource TonalButton}"
                            Command="{Binding AddCommand}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <!-- scroll clearance: the last card ends a FAB above the screen edge, never under it-->
                <CollectionView.Footer>
                    <BoxView
                        HeightRequest="{x:Static tok:DesignTokens.FabClearance}"
                        Color="Transparent"
                        tok:A11y.IsDecorative="True" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <Button
            Grid.Row="1"
            Style="{StaticResource FabButton}"
            Text="{x:Static tok:GlyphMapping.Add}"
            Command="{Binding AddCommand}"
            Margin="{x:Static tok:DesignTokens.FabMargin}"
            HorizontalOptions="End"
            VerticalOptions="End"
            SemanticProperties.Description="{x:Static res:AppStrings.PairListAdd}" />
    </Grid>
</ContentPage>
