<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="FileFerry.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:FileFerry.App.Resources"
    xmlns:conv="clr-namespace:FileFerry.App.Converters"
    xmlns:tok="clr-namespace:FileFerry.App"
    xmlns:vm="clr-namespace:FileFerry.App.ViewModels"
    x:DataType="vm:WelcomeViewModel"
    Title="{x:Static res:AppStrings.AppDisplayName}">
    <!-- Welcome screen: logo → title → subtitle → manual host/IP field (always shown) → action → help.-->
    <VerticalStackLayout
        Padding="{x:Static tok:DesignTokens.ScreenPadding}"
        Spacing="{x:Static tok:DesignTokens.Space16}"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        MaximumWidthRequest="480">
        <Label
            Text="{x:Static res:AppStrings.WelcomeTitle}"
            Style="{StaticResource Heading20}"
            HorizontalOptions="Center"
            SemanticProperties.HeadingLevel="Level1" />
        <Label
            Text="{x:Static res:AppStrings.WelcomeSubtitle}"
            Style="{StaticResource Body15}"
            TextColor="{DynamicResource TextSecondary}"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />
        <Entry
            Placeholder="{x:Static res:AppStrings.WelcomeHostHint}"
            Text="{Binding Host}"
            IsFocused="{Binding IsEntryFocused}"
            Keyboard="Url"
            ClearButtonVisibility="WhileEditing"
            SemanticProperties.Description="{x:Static res:AppStrings.WelcomeHostHint}" />
        <Label
            Text="{Binding ErrorText}"
            Style="{StaticResource Caption13}"
            TextColor="{DynamicResource StatusError}"
            IsVisible="{Binding ErrorText, Converter={x:Static conv:HasTextConverter.Instance}}" />
        <Button
            Text="{x:Static res:AppStrings.WelcomeManualIp}"
            Style="{StaticResource TextButton}"
            Command="{Binding UseManualIpCommand}"
            IsVisible="{Binding ShowManualIp}" />
        <Button
            Text="{x:Static res:AppStrings.WelcomeConnect}"
            Style="{StaticResource PrimaryButton}"
            Command="{Binding ConnectCommand}" />
        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center" />
        <Label
            Text="{x:Static res:AppStrings.HelpTitle}"
            Style="{StaticResource Caption13}"
            HorizontalOptions="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding HelpCommand}" />
            </Label.GestureRecognizers>
        </Label>
    </VerticalStackLayout>
</ContentPage>
