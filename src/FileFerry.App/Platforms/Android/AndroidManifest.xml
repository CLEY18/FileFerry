<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- Network is what the app is for; camera/microphone/location are not declared at all.-->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Settings screen: "ignore battery optimization" request for reliable background runs.-->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      FGS of dataSync type only during an active transfer. WorkManager keeps
      its own SystemForegroundService — merge foregroundServiceType into it; Android 14+
      requires both the type and a separate permission.
-->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Cleartext HTTP — permitted platform-wide in network_security_config: login and the
      WebView must reach a server named by bare IP, which NSC cannot except by name suffix.
      The guard is in-app: an explicit consent per http address and the stored account scheme.
-->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/appicon"
        android:roundIcon="@mipmap/appicon_round"
        android:networkSecurityConfig="@xml/network_security_config">
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
