<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tok="clr-namespace:FileFerry.App">
    <!--
      Typography and button styles; sizes only via DesignTokens.
      Colors only as DynamicResource onto Colors.xaml tokens; hex literals are forbidden here.
      Implicit styles provide the base theme for every control without an explicit Style.
-->

    <!-- typography: line-height 130%, sentence case, no italic-->
    <Style x:Key="Title24" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>
    <Style x:Key="Heading20" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>
    <Style x:Key="Body15" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>
    <Style x:Key="Body15Strong" TargetType="Label" BasedOn="{StaticResource Body15}">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="Caption13" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
    </Style>

    <!-- input fields 48dp, text — TextPrimary, placeholder — TextDisabled-->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextDisabled}" />
        <Setter Property="MinimumHeightRequest" Value="{x:Static tok:DesignTokens.InputHeight}" />
    </Style>

    <!-- gap between list cards (8dp) — one Resource for the whole app-->
    <Thickness x:Key="CardBottomMargin">0,0,0,8</Thickness>

    <!-- icons: Material Symbols Outlined, weight 400; the styles differ only by size-->
    <Style x:Key="IconGlyph20" TargetType="Label">
        <Setter Property="FontFamily" Value="{x:Static tok:GlyphMapping.FontFamily}" />
        <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.IconSmall}" />
    </Style>
    <Style x:Key="IconGlyph24" TargetType="Label">
        <Setter Property="FontFamily" Value="{x:Static tok:GlyphMapping.FontFamily}" />
        <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.IconMedium}" />
    </Style>
    <Style x:Key="IconEmptyState" TargetType="Label">
        <Setter Property="FontFamily" Value="{x:Static tok:GlyphMapping.FontFamily}" />
        <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.IconEmpty}" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- buttons: Filled (primary), Tonal (secondary), Text (cancel), Destructive (delete)-->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="HeightRequest" Value="{x:Static tok:DesignTokens.ButtonHeight}" />
        <Setter Property="CornerRadius" Value="{x:Static tok:DesignTokens.RadiusControl}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="TonalButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
        <Setter Property="HeightRequest" Value="{x:Static tok:DesignTokens.ButtonHeight}" />
        <Setter Property="CornerRadius" Value="{x:Static tok:DesignTokens.RadiusControl}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
        <Setter Property="HeightRequest" Value="{x:Static tok:DesignTokens.ButtonHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{x:Static tok:DesignTokens.RadiusControl}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="DestructiveButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource StatusError}" />
        <Setter Property="HeightRequest" Value="{x:Static tok:DesignTokens.ButtonHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{x:Static tok:DesignTokens.RadiusControl}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- FAB: Primary circle with a Material Symbols glyph-->
    <Style x:Key="FabButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="FontFamily" Value="{x:Static tok:GlyphMapping.FontFamily}" />
        <Setter Property="FontSize" Value="{x:Static tok:DesignTokens.IconMedium}" />
        <Setter Property="WidthRequest" Value="{x:Static tok:DesignTokens.FabSize}" />
        <Setter Property="HeightRequest" Value="{x:Static tok:DesignTokens.FabSize}" />
        <Setter Property="CornerRadius" Value="{x:Static tok:DesignTokens.FabRadius}" />
    </Style>
</ResourceDictionary>
